<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.testryn</groupId>
  <artifactId>testryn-publisher</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>testryn-publisher</name>
  <description>
    Standalone CLI that reports automated test results to Testryn's bulk result-update
    API. Deliberately NOT a Spring Boot application and NOT part of the testryn-backend
    module -- a small, dependency-light JVM tool a CI pipeline shells out to, with no
    database, web server, or framework of its own. See docs/adr/0011-ci-publisher.md.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- The one production dependency: JSON parsing/building for the publisher's
         input format and the Testryn bulk-API request/response bodies. Reusing the
         same Jackson version the backend already depends on (AGENTS.md #8: no new
         dependency without a concrete reason; this one is unavoidable and already
         proven in this codebase). No HTTP client library: see HttpUrlConnectionTransport
         javadoc for why plain java.net.HttpURLConnection is used instead of
         java.net.http.HttpClient or a third-party client. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>testryn-publisher</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Builds a single executable "fat" jar (java -jar testryn-publisher.jar ...)
           with Jackson bundled; the only way to ship a one-file CLI without asking
           every CI pipeline to manage a classpath. The Add-Opens manifest entry is
           load-bearing, not boilerplate: see HttpUrlConnectionTransport javadoc. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.testryn.publisher.PublisherMain</mainClass>
                  <manifestEntries>
                    <Add-Opens>java.base/java.net</Add-Opens>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
